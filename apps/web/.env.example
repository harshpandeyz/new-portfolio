# Optional when the static site and API are deployed on different origins.
# Leave empty for the local Vite proxy or a same-origin production proxy.
VITE_API_URL=

# Optional: WhatsApp contact button.
# When set, the contact channels render a "Chat on WhatsApp" deep link that
# opens wa.me/<number> with a pre-filled message. When unset, that channel
# degrades gracefully to the email CTA (the site still functions fully).
#

# International format, digits only (e.g. 919876543210).
VITE_WHATSAPP=

# Pre-filled message text (URL-encoded by the app automatically).
VITE_WHATSAPP_MESSAGE=Hi Harsh, I saw your portfolio and would like to connect.