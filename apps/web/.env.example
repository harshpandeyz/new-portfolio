# Frontend build-time variables (VITE_* are baked into dist/ at build time —
# rebuild after changing any of them). See the root .env.example for the
# full reference, and docs/NETLIFY_RENDER.md for Netlify dashboard settings.

# API origin for split deployments (Netlify frontend + Render API).
# Leave EMPTY for the local Vite proxy or a same-origin production proxy.
# Split example: VITE_API_URL=https://hp-os-api.onrender.com (no trailing slash).
VITE_API_URL=

# Canonical origin baked into <link rel=canonical>, og:url, sitemap.xml, robots.txt.
# Production MUST be the exact public frontend origin (e.g. https://your-site.netlify.app).
# Every VITE_SITE_URL origin must also be listed in the API's APP_URL (CORS).
VITE_SITE_URL=http://localhost:5173

# Local dev only: API port the Vite proxy forwards /api + /static to.
# Production builds ignore this (nginx / Netlify redirects handle routing).
# VITE_API_PORT=4000

# Optional: WhatsApp contact button.
# International format, digits only, no "+" (e.g. 9198XXXXXXXX). When empty the
# WhatsApp channel degrades gracefully to the email CTA — the site still works fully.
VITE_WHATSAPP=

# Pre-filled message text (URL-encoded by the app automatically).
VITE_WHATSAPP_MESSAGE=Hi Harsh, I saw your portfolio and would like to connect.
