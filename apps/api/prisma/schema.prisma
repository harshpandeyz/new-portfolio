// HP//OS — Prisma schema
// PostgreSQL data model for the portfolio system.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ── Identity / access ────────────────────────────────────────

enum Role {
  // EDITOR and VIEWER remain for existing database compatibility only; API
  // authentication admits ADMIN accounts exclusively.
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  passwordHash        String
  role                Role           @default(VIEWER)
  displayName         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  passwordChangedAt   DateTime?
  totpSecret          String?
  totpEnabled         Boolean        @default(false)
  totpEnabledAt       DateTime?
  totpLastCounter     BigInt?
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  sessions            Session[]
  recoveryCodes       RecoveryCode[]
  loginChallenges     LoginChallenge[]

  @@index([email])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginChallenge {
  nonceHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// Shared PostgreSQL rate-limit buckets; keyHash is an HMAC, never raw IP/email.
model RateLimitBucket {
  keyHash String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model ProviderCooldown {
  provider      String   @id
  failures      Int      @default(0)
  cooldownUntil DateTime?
  touchedAt     DateTime @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  reauthAt   DateTime @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// ── Content ──────────────────────────────────────────────────

model Profile {
  id           String   @id @default(cuid())
  name         String
  headline     String
  subHeadline  String
  bio          String
  recruiterSummary String   @default("")
  location     String
  email        String
  availability String   @default("")
  avatarUrl    String?
  resumeUrl    String?
  resumeLabel  String?
  updatedAt    DateTime @updatedAt
  socials      SocialLink[]
}

model SocialLink {
  id       String  @id @default(cuid())
  profileId String
  profile  Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label    String
  url      String
  handle   String?
  order    Int     @default(0)

  @@index([profileId])
}

model Project {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  codename         String?
  shortDescription String
  longDescription  String?
  category         String
  domains          ProjectDomain[] @default([])
  tier             String
  status           String        @default("complete")
  featured         Boolean       @default(false)
  year             String
  order            Int           @default(0)
  problem          String?
  solution         String?
  architecture     String?
  decisions        String[]  @default([])
  challenges       String?
  results          String?
  securityNotes    String?
  securityReliability String?
  dataFlow         String[]  @default([])
  stack            String[]  @default([])
  githubUrl        String?
  liveUrl          String?
  heroImage        String?
  gallery          String[]  @default([])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([slug])
  @@index([tier])
  @@index([featured])
  @@index([status])
  @@index([updatedAt])
}

enum ProjectDomain {
  BACKEND
  AI_ML
  FULL_STACK
  MOBILE
  FRONTEND
  DEVOPS
}

model Certificate {
  id            String   @id @default(cuid())
  title         String
  issuer        String
  issuedOn      String?
  category      String
  credentialId  String?
  credentialUrl String?
  fileUrl       String?
  description   String?
  featured      Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([issuer])
}

model Skill {
  id              String   @id @default(cuid())
  name            String
  category        String
  level           String
  description     String?
  usedInProjectSlugs String[] @default([])
  relatedConcepts String[]
  recruiterPriority Int     @default(0)
  featured        Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([level])
}

model Education {
  id           String  @id @default(cuid())
  degree       String
  institution  String
  field        String?
  startYear    String
  endYear      String?
  grade        String?
  description  String?
  primary      Boolean @default(false)
  order        Int     @default(0)
}

model TimelineItem {
  id           String   @id @default(cuid())
  date         String
  endDate      String?
  title        String
  organization String?
  description  String?
  type         String
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([date])
}

/// ── Communication / operations ───────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("NEW")
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  repliedAt DateTime?
  replies   MessageReply[]

  @@index([status])
  @@index([createdAt])
  @@index([email, createdAt])
}

model MessageReply {
  id        String         @id @default(cuid())
  messageId String
  message   ContactMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  to        String
  subject   String
  body      String
  sentBy    String?
  sentAt    DateTime       @default(now())

  @@index([messageId])
  @@index([sentAt])
}

model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  storedName  String   @unique
  url         String
  mimeType    String
  sizeBytes   Int
  kind        String
  title       String?
  createdAt   DateTime @default(now())
  versions    MediaAssetVersion[]

  @@index([kind])
  @@index([createdAt])
}

model MediaAssetVersion {
  id          String     @id @default(cuid())
  assetId     String?
  asset       MediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  filename    String
  storedName  String
  url         String
  mimeType    String
  sizeBytes   Int
  kind        String
  title       String?
  createdAt   DateTime   @default(now())
  deleteAfter DateTime

  @@index([assetId, createdAt])
  @@index([deleteAfter])
  @@index([storedName])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
  @@index([action])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  ref       String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

/// ── AI provider configuration (admin-managed, secrets encrypted) ──
///
/// API keys are AES-256-GCM encrypted at rest and NEVER returned to the
/// browser. List/detail responses expose only `hasKey` + `keyHint`
/// (e.g. "****ab12"). The browser talks to our backend; the backend talks
/// to the configured LLM provider.
model AiProviderConfig {
  id            String    @id @default(cuid())
  name          String    @unique
  kind          String    @default("custom")
  baseUrl       String
  model         String
  apiKeyEnc     String?
  keyHint       String?
  temperature   Float     @default(0.2)
  maxTokens     Int       @default(500)
  timeoutMs     Int       @default(20000)
  enabled       Boolean   @default(true)
  priority      Int       @default(0)
  isFallback    Boolean   @default(false)
  health        String    @default("unknown")
  lastLatencyMs Int?
  lastError     String?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([enabled, priority])
  @@index([health])
}
