// HP//OS — Prisma schema
// PostgreSQL data model for the portfolio system.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ── Identity / access ────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("ADMIN")
  displayName  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@index([email])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// ── Content ──────────────────────────────────────────────────

model Profile {
  id           String   @id @default(cuid())
  name         String
  headline     String
  subHeadline  String
  bio          String
  location     String
  email        String
  availability String   @default("")
  avatarUrl    String?
  resumeUrl    String?
  resumeLabel  String?
  updatedAt    DateTime @updatedAt
  socials      SocialLink[]
}

model SocialLink {
  id       String  @id @default(cuid())
  profileId String
  profile  Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label    String
  url      String
  handle   String?
  order    Int     @default(0)

  @@index([profileId])
}

model Project {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  codename         String?
  shortDescription String
  longDescription  String?
  category         String
  tier             String
  status           String        @default("complete")
  featured         Boolean       @default(false)
  year             String
  order            Int           @default(0)
  problem          String?
  solution         String?
  architecture     String?
  decisions        String[]  @default([])
  challenges       String?
  results          String?
  securityNotes    String?
  dataFlow         String[]  @default([])
  stack            String[]  @default([])
  githubUrl        String?
  liveUrl          String?
  heroImage        String?
  gallery          String[]  @default([])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([slug])
  @@index([tier])
  @@index([featured])
  @@index([status])
  @@index([updatedAt])
}

model Certificate {
  id            String   @id @default(cuid())
  title         String
  issuer        String
  issuedOn      String?
  category      String
  credentialId  String?
  credentialUrl String?
  fileUrl       String?
  description   String?
  featured      Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([issuer])
}

model Skill {
  id              String   @id @default(cuid())
  name            String
  category        String
  level           String
  description     String?
  usedIn          String[]
  relatedConcepts String[]
  featured        Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([level])
}

model Education {
  id           String  @id @default(cuid())
  degree       String
  institution  String
  field        String?
  startYear    String
  endYear      String?
  grade        String?
  description  String?
  order        Int     @default(0)
}

model TimelineItem {
  id           String   @id @default(cuid())
  date         String
  endDate      String?
  title        String
  organization String?
  description  String?
  type         String
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
  @@index([date])
}

/// ── Communication / operations ───────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("NEW")
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model MediaAsset {
  id          String   @id @default(cuid())
  filename    String
  storedName  String   @unique
  url         String
  mimeType    String
  sizeBytes   Int
  kind        String
  title       String?
  createdAt   DateTime @default(now())

  @@index([kind])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
  @@index([action])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  ref       String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model ChatQueryLog {
  id        String   @id @default(cuid())
  question  String
  confidence String
  provider  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
