{
  "name": "@hp/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/apps/api/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:migrate": "node ../../scripts/prisma-cli.mjs migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "node ../../scripts/prisma-cli.mjs migrate dev --schema prisma/schema.prisma",
    "db:generate": "node ../../scripts/prisma-cli.mjs generate --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node ../../scripts/prisma-cli.mjs studio --schema prisma/schema.prisma",
    "test": "TEST_MODE=1 vitest run --config tests/vitest.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^10.1.3",
    "@hp/shared": "*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.1.0",
    "nodemailer": "^9.0.6",
    "otplib": "^12.0.1",
    "prisma": "^5.22.0",
    "qrcode": "1.5",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^6.4.16",
    "@types/qrcode": "1.5",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
