# Copy this file to the deployment host as .env. Replace every REPLACE value
# with a unique `openssl rand -hex 32` value. Never commit the completed file.
COMPOSE_PROJECT_NAME=hp-os
# Verify this private Docker subnet does not overlap the Oracle VCN before use.
APP_SUBNET=172.30.0.0/24
DB_IPV4=172.30.0.10
API_IPV4=172.30.0.20
WEB_IPV4=172.30.0.30
DATABASE_VOLUME_NAME=hp-os_hp_pgdata
UPLOAD_VOLUME_NAME=hp-os_hp_uploads

# Loopback-only maintenance ports; change only if the VM already uses them.
POSTGRES_HOST_PORT=5432
API_HOST_PORT=4000
WEB_HOST_PORT=5173

POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_SUPERUSER_SECRET
POSTGRES_APP_PASSWORD=REPLACE_WITH_64_HEX_RUNTIME_ROLE_SECRET
POSTGRES_MIGRATOR_PASSWORD=REPLACE_WITH_64_HEX_MIGRATION_ROLE_SECRET

SESSION_SECRET=REPLACE_WITH_64_HEX_SESSION_SECRET
SESSION_SECRET_PREVIOUS=
AI_CONFIG_KEY=REPLACE_WITH_64_HEX_AI_ENCRYPTION_KEY
AI_CONFIG_KEY_PREVIOUS=
TOTP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_TOTP_ENCRYPTION_KEY
TOTP_ENCRYPTION_KEY_PREVIOUS=

# Docker/Caddy origins: these two must be identical (single public origin).
# Split deployments (Netlify + Render) differ instead: APP_URL is the frontend
# origin allow-list (comma-separated when a custom domain is added) and
# VITE_SITE_URL is the same site URL baked into the web bundle. See
# docs/NETLIFY_RENDER.md.
APP_URL=https://portfolio.example.org
VITE_SITE_URL=https://portfolio.example.org
# Fastify trusts only the Web NGINX container's fixed Compose address.
TRUST_PROXY=172.30.0.30/32

MAX_UPLOAD_MB=25
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Resend HTTPS mail is optional. If configured, use a verified sender domain.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_NOTIFY_EMAIL=
REPLY_FROM_NAME=Portfolio

# Optional public GitHub API token; the site degrades without it.
GITHUB_TOKEN=

# Bootstrap is interactive and one-time. These values are intentionally not
# passed to the API container. Keep both empty for the normal configuration.
ADMIN_EMAIL=
ADMIN_PASSWORD=
