# Disposable database target for scripts/restore.sh. Do not use this file to
# start the API or web services. Use the dedicated project/volumes/port below.
COMPOSE_PROJECT_NAME=hp-os-restore
APP_SUBNET=172.31.254.0/24
DB_IPV4=172.31.254.10
API_IPV4=172.31.254.20
WEB_IPV4=172.31.254.30
POSTGRES_HOST_PORT=55433
DATABASE_VOLUME_NAME=hp-os-restore_hp_pgdata
UPLOAD_VOLUME_NAME=hp-os-restore_hp_uploads

POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_64_HEX_VALUE
POSTGRES_APP_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_VALUE
POSTGRES_MIGRATOR_PASSWORD=REPLACE_WITH_ANOTHER_64_HEX_VALUE

# Required by Compose interpolation. Restore runs only the isolated db service.
APP_URL=https://restore.invalid
VITE_SITE_URL=https://restore.invalid
TRUST_PROXY=172.31.254.30/32
SESSION_SECRET=REPLACE_WITH_RANDOM_VALUE
AI_CONFIG_KEY=REPLACE_WITH_DIFFERENT_RANDOM_VALUE
TOTP_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_RANDOM_VALUE
