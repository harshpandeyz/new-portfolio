# ──────────────────────────────────────────────────────────────
# HP//OS environment — copy to .env and fill in.
# NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────

# Database (docker compose provides this on localhost:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hp_os

# Separate database used ONLY by the API test-suite (npm run test:api)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hp_os_test

# Public URL of the web app (used for CORS + canonical links).
# Comma-separated for multiple origins (prod + previews). No trailing slash.
APP_URL=http://localhost:5173

# API port
API_PORT=4000
# NOTE: API_URL is legacy/unused — the frontend uses VITE_API_URL instead.
# See apps/web/.env.example for VITE_API_URL / VITE_SITE_URL / VITE_WHATSAPP*.

# ── Reverse-proxy trust ───────────────────────────────────────
# Number of trusted reverse-proxy hops in front of the API (default 1).
# A bounded hop count prevents clients from spoofing X-Forwarded-For to
# bypass IP rate limits. Set 0 / false when the API is exposed directly,
# or a comma-separated IP/CIDR list to trust specific proxy addresses.
# TRUST_PROXY=1

# ── Admin bootstrap (used ONLY by `npm run admin:create` / first seed) ──
ADMIN_EMAIL=admin@harshpandey.dev
ADMIN_PASSWORD=

# Session cookie signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=

# ── LLM provider for HARSH AI (optional) ─────────────────────
# Preferred: configure providers in the private control center
# (/private/ai-providers) — OpenRouter, NVIDIA, OpenAI-compatible. Keys are
# AES-256-GCM encrypted at rest and never exposed to the browser.
# The env below remains as a server-side fallback when no DB provider is set.
# Provider: openai | openrouter | nvidia | groq | custom | none (default: none → deterministic retrieval answers)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Dedicated encryption key for AI provider secrets (optional — falls back to
# SESSION_SECRET-derived key). Generate with: openssl rand -hex 32
# AI_CONFIG_KEY=

# ── Email: notifications + direct inbox replies ────────────────
# Production (Render Free blocks outbound SMTP ports 25/465/587), use the
# HTTPS email API. Local dev can keep Gmail SMTP instead — the app picks
# Resend automatically when RESEND_API_KEY is set, unless EMAIL_PROVIDER
# pins one explicitly ("resend" | "smtp").
# EMAIL_PROVIDER=
# Resend: create a key at https://resend.com/api-keys, then verify a
# sending domain (or use "onboarding@resend.dev" for tests only — it can
# only send to your own account email).
RESEND_API_KEY=
# Verified sender identity, e.g. "Harsh Pandey <hello@yourdomain.com>".
EMAIL_FROM=
# Display name visitors see on your replies (used when EMAIL_FROM carries
# no display name, and always for SMTP sends).
REPLY_FROM_NAME=Harsh Pandey

# ── SMTP: local-dev fallback only (blocked on Render Free) ─────────
# Gmail: host smtp.gmail.com, port 587, user = your address,
# password = an App Password (Google Account → Security → 2-Step → App passwords).
# NEVER use your real login password here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=harshap17058@gmail.com
SMTP_PASSWORD=
# Inbox copy of new messages (usually your own address).
CONTACT_NOTIFY_EMAIL=harshap17058@gmail.com

# ── GitHub live integration (optional, raises rate limits) ──
GITHUB_TOKEN=

# ── Media storage ─────────────────────────────────────────────
# local is the only implemented driver; s3 is reserved for future use.
STORAGE_DRIVER=local
# Relative to the API package root (apps/api/uploads), not the process CWD.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
