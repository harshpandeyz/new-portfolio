# ──────────────────────────────────────────────────────────────
# HP//OS local development environment — copy to .env and fill in.
# Oracle production uses deploy/.env.production.example and the preflight
# command in docs/DEPLOYMENT.md.
# NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────

# Database (docker compose provides this on localhost:5432)
DATABASE_URL=postgresql://postgres:replace-this-password@localhost:5432/hp_os
POSTGRES_PASSWORD=replace-this-password
# Local Compose defaults these to POSTGRES_PASSWORD. Production requires
# separate random 64-hex credentials for both roles.
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_PASSWORD=

# Test wrappers ignore this value and construct a disposable URL to the
# isolated hp-os-test Compose project on port 55432.
TEST_DATABASE_URL=postgresql://postgres:replace-this-password@localhost:55432/hp_os_test

# Local public URL of the web app (used for local CORS + canonical links).
APP_URL=http://localhost:5173
VITE_SITE_URL=http://localhost:5173

# API port
API_PORT=4000
# NOTE: API_URL is legacy/unused — the frontend uses VITE_API_URL instead.
# See apps/web/.env.example for VITE_API_URL / VITE_SITE_URL / VITE_WHATSAPP*.

# ── Reverse-proxy trust ───────────────────────────────────────
# For local direct API development leave empty (trust no proxy). Production
# sets the exact NGINX container address: 172.30.0.30/32.
# TRUST_PROXY=

# ── Optional local admin seed. Production bootstrap is interactive and one-off. ──
ADMIN_EMAIL=admin@harshpandey.dev
ADMIN_PASSWORD=

# Session cookie signing secret — generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_SECRET_PREVIOUS=

# ── LLM provider for HARSH AI (optional) ─────────────────────
# Preferred: configure providers in the private control center
# (/private/ai-providers) — OpenRouter, NVIDIA, OpenAI-compatible. Keys are
# AES-256-GCM encrypted at rest and never exposed to the browser.
# The env below remains as a server-side fallback when no DB provider is set.
# Provider: openai | openrouter | nvidia | groq | custom | none (default: none → deterministic retrieval answers)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Dedicated persistent key for AI provider secrets. Required in production.
# Existing records encrypted with SESSION_SECRET remain readable during migration.
# Generate with: openssl rand -hex 32
AI_CONFIG_KEY=
AI_CONFIG_KEY_PREVIOUS=

# Dedicated persistent key for TOTP secrets. Required in production; old
# SESSION_SECRET-encrypted TOTP records remain readable as a legacy fallback.
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY_PREVIOUS=

# ── Email: notifications + direct inbox replies ────────────────
# For cloud deployments, use the HTTPS email API. Local development can use
# Gmail SMTP — the app picks
# Resend automatically when RESEND_API_KEY is set, unless EMAIL_PROVIDER
# pins one explicitly ("resend" | "smtp").
# EMAIL_PROVIDER=
# Resend: create a key at https://resend.com/api-keys, then verify a
# sending domain (or use "onboarding@resend.dev" for tests only — it can
# only send to your own account email).
RESEND_API_KEY=
# Verified sender identity, e.g. "Harsh Pandey <hello@yourdomain.com>".
EMAIL_FROM=
# Display name visitors see on your replies (used when EMAIL_FROM carries
# no display name, and always for SMTP sends).
REPLY_FROM_NAME=Harsh Pandey

# ── SMTP: local-development fallback ────────────────────────────────
# Gmail: host smtp.gmail.com, port 587, user = your address,
# password = an App Password (Google Account → Security → 2-Step → App passwords).
# NEVER use your real login password here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=harshap17058@gmail.com
SMTP_PASSWORD=
# Inbox copy of new messages (usually your own address).
CONTACT_NOTIFY_EMAIL=harshap17058@gmail.com

# ── GitHub live integration (optional, raises rate limits) ──
GITHUB_TOKEN=

# ── Media storage ─────────────────────────────────────────────
# local is the only implemented driver; s3 is reserved for future use.
STORAGE_DRIVER=local
# Relative to the API package root (apps/api/uploads), not the process CWD.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
