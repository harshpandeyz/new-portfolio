# ──────────────────────────────────────────────────────────────
# HP//OS environment reference — copy to .env and fill in.
# NEVER commit the real .env file.
#
# Columns: NAME | required? | consumed by | purpose.
# "local"  = npm run dev / docker compose up (this machine).
# "oracle" = private Docker/Caddy host (docs/DEPLOYMENT.md).
# "render" = Render Blueprint (render.yaml + docs/NETLIFY_RENDER.md).
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# DATABASE_URL | required(local,render) | api runtime+migrate | Prisma connection.
#   local:  docker compose db → postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/hp_os
#   render: injected from the managed database (DO NOT set manually).
DATABASE_URL=postgresql://postgres:replace-this-password@localhost:5432/hp_os
# POSTGRES_PASSWORD | required(local,oracle) | compose db superuser + fallback for the two role passwords below.
POSTGRES_PASSWORD=replace-this-password
# POSTGRES_APP_PASSWORD | required(oracle) | compose db init + api runtime role (hp_app).
#   local compose defaults to POSTGRES_PASSWORD. Production needs a separate random 64-hex value.
POSTGRES_APP_PASSWORD=
# POSTGRES_MIGRATOR_PASSWORD | required(oracle) | compose migrate role (hp_migrator).
POSTGRES_MIGRATOR_PASSWORD=
# TEST_DATABASE_URL | ignored | test wrappers always build the disposable hp-os-test URL themselves.
#   Kept only so direct `vitest` runs outside the wrapper fail closed instead of touching dev data.
TEST_DATABASE_URL=postgresql://postgres:replace-this-password@localhost:55432/hp_os_test

# ── Origins (frontend ↔ API) ────────────────────────────────
# APP_URL | required(all) | api CORS + canonical links. Comma-separated allow-list accepted
#   (e.g. Netlify site + custom domain). Production entries must ALL be public https origins.
APP_URL=http://localhost:5173
# VITE_SITE_URL | required(all) | web build-time canonical/og/sitemap (baked into dist/).
#   Every VITE_SITE_URL origin must be listed in APP_URL. Rebuild the frontend after changing it.
VITE_SITE_URL=http://localhost:5173
# COMPOSE_API_APP_URL | optional(local-compose) | compose api only. Production Docker images reject
#   localhost APP_URL, so local `docker compose up` uses this https placeholder origin instead.
#   The dev flow (npm run dev) keeps using APP_URL and ignores this.
COMPOSE_API_APP_URL=https://portfolio.invalid

# ── Ports ─────────────────────────────────────────────────────
# API_PORT | optional | api listen port. Render injects PORT instead (wins when set).
API_PORT=4000
# PORT | auto(render) | platform-injected API port. Never set manually.
# PORT=

# ── Reverse-proxy trust ───────────────────────────────────────
# TRUST_PROXY | required(oracle,render) | api req.ip source. Docker/Caddy production: exact NGINX
#   container IP (172.30.0.30/32). Render: TRUST_PROXY=1 with RENDER=true (dynamic edge IPs).
#   Local direct dev: leave empty (trust no proxy).
# TRUST_PROXY=
# RENDER | render-only | api. Set RENDER=true on Render so hop-count proxy trust is accepted.
# RENDER=

# ── Cross-origin session cookies ──────────────────────────────
# COOKIE_SAMESITE | optional | api session+CSRF cookies. Same-origin deployments: lax (default).
#   Split origins (Netlify frontend + Render API): none (Secure is forced automatically).
# COOKIE_SAMESITE=lax
# COOKIE_SECURE | optional | api. Explicit true/false overrides the default (prod=true, plus forced
#   true when COOKIE_SAMESITE=none).
# COOKIE_SECURE=

# ── Secrets (persistent — generate ONCE, never rotate blindly) ─
# Admin sessions, TOTP seeds and AI provider keys encrypted under these values
# remain readable only while the values are preserved. Generate with: openssl rand -hex 32
# SESSION_SECRET | required(all) | api session signing + legacy decryption fallback.
SESSION_SECRET=
# SESSION_SECRET_PREVIOUS | optional | api. Previous secret, kept only across a planned rotation.
SESSION_SECRET_PREVIOUS=
# AI_CONFIG_KEY | required(oracle,render) | api AI-provider key encryption. Records encrypted under
#   SESSION_SECRET stay readable as a fallback, but the key must still be set and distinct.
AI_CONFIG_KEY=
AI_CONFIG_KEY_PREVIOUS=
# TOTP_ENCRYPTION_KEY | required(oracle,render) | api TOTP seed encryption. Same fallback rule.
TOTP_ENCRYPTION_KEY=
TOTP_ENCRYPTION_KEY_PREVIOUS=

# ── Admin bootstrap (one-off, interactive) ────────────────────
# The API container NEVER reads these (compose deliberately does not pass them through).
# Used only by `npm run admin:create` / first-seed flows.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── HARSH AI provider fallback (optional) ─────────────────────
# Preferred: configure providers in the private control center (/private/ai-providers) —
# keys are AES-256-GCM encrypted at rest and never exposed to the browser.
# The env below is a server-side fallback when no DB provider is set.
# LLM_PROVIDER | optional | api. openai | openrouter | nvidia | groq | custom | none (default: none).
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ── Email: notifications + direct inbox replies ───────────────
# EMAIL_PROVIDER | optional | api. "resend" | "smtp". Auto-selected: resend when RESEND_API_KEY is
#   set (required on Render — SMTP ports are restricted), else smtp.
# EMAIL_PROVIDER=
# RESEND_API_KEY | required(render) | api via https://api.resend.com. Create at
#   https://resend.com/api-keys and verify the sending domain first.
RESEND_API_KEY=
# EMAIL_FROM | required with RESEND_API_KEY | api. Verified sender, e.g. "Harsh Pandey <hello@yourdomain.com>".
EMAIL_FROM=
# REPLY_FROM_NAME | optional | api. Display name on visitor replies when EMAIL_FROM carries no name.
REPLY_FROM_NAME=Harsh Pandey
# SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASSWORD | required iff EMAIL_PROVIDER=smtp | api + validation.
#   Gmail: host smtp.gmail.com, port 587, user = your address, password = an App Password
#   (Google Account → Security → 2-Step → App passwords). NEVER use a login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=
# CONTACT_NOTIFY_EMAIL | required when email is configured | api. Inbox copy of new messages.
CONTACT_NOTIFY_EMAIL=you@yourdomain.com

# ── GitHub live integration (optional, raises rate limits) ───
# GITHUB_TOKEN | optional | api. Public data works without it.
GITHUB_TOKEN=

# ── Media storage ─────────────────────────────────────────────
# STORAGE_DRIVER | informational | api. Only "local" is implemented; "s3" is reserved.
STORAGE_DRIVER=local
# UPLOAD_DIR | optional | api. Relative to apps/api (not the process CWD); absolute paths allowed
#   (Render Disk mounts at /opt/render/project/src/apps/api/uploads).
UPLOAD_DIR=uploads
# MAX_UPLOAD_MB | optional | api + nginx (client_max_body_size = +1 MiB).
MAX_UPLOAD_MB=25

# ── Local compose overrides (rarely changed) ──────────────────
# POSTGRES_HOST_PORT / API_HOST_PORT / WEB_HOST_PORT | optional | compose loopback bindings.
# COMPOSE_PROJECT_NAME / DATABASE_VOLUME_NAME / UPLOAD_VOLUME_NAME | optional | compose naming.
#   WARNING: renaming the project/volume names orphans the existing pgdata volume (data loss
#   of the local DB copy). Never `docker compose down -v` unless you intend to wipe local data.
# APP_SUBNET / DB_IPV4 / API_IPV4 / WEB_IPV4 | optional(oracle) | compose private network.
# API_IMAGE / WEB_IMAGE | optional | compose image tags for versioned releases (see deploy.sh).
# VITE_API_URL / VITE_API_PORT / VITE_WHATSAPP / VITE_WHATSAPP_MESSAGE | optional | compose web
#   build args + Netlify env. VITE_API_URL=http(s)://<api-origin> for split deployments (empty =
#   same-origin). VITE_WHATSAPP = digits-only E.164 number, e.g. 9198XXXXXXXX.

# ── E2E / test harness (never production) ─────────────────────
# E2E_BASE_URL / E2E_API_PORT / E2E_WEB_PORT / E2E_NO_SERVER | e2e only | playwright.config.ts.
# TEST_MODE=1 is forced by scripts/run-api-tests.mjs and REFUSED in production (fail-fast).
# CERTIFICATES_SOURCE_DIR | seed-only | apps/api/prisma/seed.ts asset import (dev/seed flows).
